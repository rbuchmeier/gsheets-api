{
  "name": "gsheets-api",
  "version": "2.0.0",
  "description": "A REST API layered on top of registered Google Sheets",
  "type": "module",
  "main": "dist/src/index.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/src/index.js",
    "build": "tsc -p tsconfig.build.json",
    "gcp-build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "apikey": "gcloud secrets versions access latest --secret=gsheets-api-keys --project=\"${GCP_PROJECT_ID:-general-usage-348604}\""
  },
  "author": "Ryan Buchmeier",
  "license": "MIT",
  "dependencies": {
    "@googleapis/sheets": "^9.0.0",
    "@hono/node-server": "^1.13.0",
    "google-auth-library": "^9.14.0",
    "hono": "^4.6.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.12.0",
    "@types/node": "^22.7.0",
    "eslint": "^9.12.0",
    "prettier": "^3.3.3",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.8.0",
    "vitest": "^2.1.0"
  }
}
